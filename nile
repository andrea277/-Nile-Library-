SELECT *
FROM members;
SELECT title AS "Book Title",
       author AS "Author",
       price AS "Price"
FROM books;

SELECT DISTINCT city
FROM members;
SELECT title,
       ROUND(price * 1.14, 2) AS price_with_vat
FROM books;
SELECT *
FROM members
WHERE city = 'Cairo';

SELECT *
FROM books
WHERE price > 300
  AND copies_available > 0;
SELECT *
FROM books
WHERE price BETWEEN 100 AND 500;
SELECT *
FROM members
WHERE city IN ('Cairo', 'Giza', 'Alexandria');
SELECT *
FROM books
WHERE title LIKE 'A%'
   OR title LIKE '%y';
SELECT *
FROM members
WHERE phone IS NULL;
SELECT *
FROM books
ORDER BY price DESC, title ASC;
SELECT full_name AS "Member Name",
       phone AS "Phone Number",
       points AS "Total Points"
FROM members
WHERE city IN ('Cairo', 'Giza')
  AND phone IS NOT NULL
ORDER BY points DESC;
SELECT full_name || ' ' || city AS member_info
FROM members;
SELECT UPPER(full_name) AS member_name,
       LENGTH(full_name) AS name_length
FROM members;
SELECT SUBSTR(email, 1, INSTR(email, '@') - 1) AS email_username
FROM members
WHERE email IS NOT NULL;
SELECT *
FROM members
WHERE joined_on < ADD_MONTHS(SYSDATE, -6)
  AND points < 200;
SELECT *
FROM members
WHERE city IN ('Cairo', 'Giza')
  AND points >= 100;
SELECT *
FROM books
WHERE price BETWEEN 100 AND 500;
SELECT title,
       ROUND(price * 1.14, 2) AS price_vat
FROM books
WHERE price * 1.14 > 500;
